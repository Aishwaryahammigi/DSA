import java.util.Arrays;

class Solution {
    public int knapsack(int W, int val[], int wt[]) {
        int[][] dp = new int[val.length + 1][W + 1];
        
        for(int i = 1; i <= val.length; i++) 
        {
            dp[i][0] = 0;
        }
        
        for(int j = 1; j <= W; j++) 
        {
            dp[0][j] = 0;
        }
        
        for(int i = 1; i <= val.length; i++){
            for(int j = 1; j <= W; j++) {
                int value = val[i - 1];
                int weight = wt[i - 1];
                
                if (weight <= j) {
                    int ans1 = value + dp[i - 1][j - weight];
                    int ans2 = dp[i - 1][j];
                    
                    dp[i][j] = Math.max(ans1, ans2);
                } else {
                    dp[i][j] = dp[i - 1][j];
                }
            }
        }
        
        return dp[val.length][W];
    }
}
