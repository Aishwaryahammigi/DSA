class Solution {
    public int knapsack(int W, int val[], int wt[]) {
        return solve(val, wt, W, val.length);
    }
    
    public int solve(int val[], int wt[], int W, int n) {
        if (W == 0 || n == 0) {
            return 0;
        }
        
        if (wt[n-1] <= W) {
            int ans1 = val[n-1] + solve(val, wt, W-wt[n-1], n-1);
            int ans2 = solve(val, wt, W, n-1);
            return Math.max(ans1, ans2);
        } else {
            return solve(val, wt, W, n-1);
        }
    }
}
