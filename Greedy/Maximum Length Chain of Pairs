class Solution {
    public int maxChainLen(int arr[][]) {
        // code here
        int n = arr.length;
        
        Arrays.sort(arr, (a,b) -> a[1] - b[1]);
        
        int count = 1;
        int lastEnd = arr[0][1];
        for(int i = 1; i < n; i++) {
            if(arr[i][0] > lastEnd) {
                count++;
                lastEnd = arr[i][1];
            }
        }
        
        return count;
    }
}
