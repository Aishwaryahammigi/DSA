import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {

            int m = sc.nextInt();
            int n = sc.nextInt();

            // m - 1 vertical cuts
            Integer costVer[] = new Integer[m - 1];

            // n - 1 horizontal cuts
            Integer costHor[] = new Integer[n - 1];

            for (int i = 0; i < m - 1; i++) {
                costVer[i] = sc.nextInt();
            }

            for (int i = 0; i < n - 1; i++) {
                costHor[i] = sc.nextInt();
            }

            Arrays.sort(costVer, Collections.reverseOrder());
            Arrays.sort(costHor, Collections.reverseOrder());

            int v = 0;
            int h = 0;

            int vp = 1;
            int hp = 1;

            int cost = 0;

            // Process both arrays
            while (v < costVer.length && h < costHor.length) {

                if (costVer[v] > costHor[h]) {
                    // Vertical cut
                    cost += costVer[v] * hp;
                    vp++;
                    v++;
                } else {
                    // Horizontal cut
                    cost += costHor[h] * vp;
                    hp++;
                    h++;
                }
            }

            // Remaining vertical cuts
            while (v < costVer.length) {
                cost += costVer[v] * hp;
                v++;
            }

            // Remaining horizontal cuts
            while (h < costHor.length) {
                cost += costHor[h] * vp;
                h++;
            }

            System.out.println(cost);
        }

        sc.close();
    }
}
